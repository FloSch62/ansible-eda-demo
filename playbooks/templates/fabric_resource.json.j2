{# Render a Fabric resource payload merging optional metadata labels and spec overrides. #}
{% set label_defaults = {'demo.nokia.com/source': 'uv-ansible-toponodes'} %}
{% set merged_labels = label_defaults | combine(item.labels | default({})) %}
{
  "apiVersion": "fabrics.eda.nokia.com/v1alpha1",
  "kind": "Fabric",
  "metadata": {
    "namespace": "{{ item.namespace | default(eda_namespace) }}",
    "name": "{{ item.name }}",
    "labels": {{ merged_labels | to_nice_json(indent=2) }}
  },
  "spec": {{ item.spec | default({}) | to_nice_json(indent=2) }}
}
