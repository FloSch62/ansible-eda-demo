{# Render Interface resource payload for both network interfaces and edge bundles. #}
{% set base_labels = {'demo.nokia.com/source': 'uv-ansible-toponodes'} %}
{% set merged_labels = base_labels | combine(item.labels | default({})) %}
{% set metadata = {
  'namespace': item.namespace | default(eda_namespace),
  'name': item.name,
  'labels': merged_labels
} %}
{% if item.annotations is defined and item.annotations is not none %}
  {% set metadata = metadata | combine({'annotations': item.annotations}) %}
{% endif %}
{% if item.spec is defined %}
  {% set spec = item.spec %}
{% else %}
  {% set spec = {
    'type': item.type | default('interface'),
    'members': item.members
  } %}
  {% if item.description is defined and item.description is not none %}
    {% set spec = spec | combine({'description': item.description}) %}
  {% endif %}
{% endif %}
{
  "metadata": {{ metadata | to_nice_json(indent=2) }},
  "spec": {{ spec | to_nice_json(indent=2) }}
}
